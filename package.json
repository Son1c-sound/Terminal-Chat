{
  "name": "ws-chat-cli",
  "version": "1.0.0",
  "description": "Terminal-based WebSocket chat client",
  "main": "client.js",
  "type": "module",
  "bin": {
    "x-chat": "./x-chat.js"
  },
  "scripts": {
    "start": "node src/index.js --username \"$(whoami)\"",
