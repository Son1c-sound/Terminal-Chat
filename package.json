    "commander": "^11.1.0",
    "figlet": "^1.7.0",
    "gradient-string": "^2.0.2",
    "neo-blessed": "^0.2.0",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.7.4"
  }
